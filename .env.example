# Shared
NODE_ENV=development

# API (never expose these in VITE_ variables)
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
SQLITE_PATH=/data/kinan.sqlite
ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
DEVICE_LOGIN_WINDOW_MS=60000
DEVICE_LOGIN_MAX_ATTEMPTS=10
TELEMETRY_MAX_SAMPLES=500
RETENTION_DAYS=30

# Web (public Firebase config only)
VITE_API_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=replace
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace
VITE_FIREBASE_APP_ID=replace

# Simulator
SIMULATOR_API_URL=http://localhost:3000
SIMULATOR_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
SIMULATOR_AUTH_BASE_URL=https://identitytoolkit.googleapis.com
SIMULATOR_FIREBASE_API_KEY=replace
SIMULATOR_PARAMETER_IDS=parameter_1,parameter_2
SIMULATOR_INTERVAL_MS=10000
SIMULATOR_HISTORY_INTERVAL_MS=60000
SIMULATOR_DEVICE_ID=replace
SIMULATOR_DEVICE_SECRET=replace
