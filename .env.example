NODE_ENV=development
API_PORT=3000
APP_ORIGIN=http://localhost:5173
SQLITE_PATH=/data/kinan.sqlite
# Generate once; retain the existing key when migrating legacy ciphertext.
ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
REDIS_URL=redis://redis:6379
MQTT_URL=mqtt://mosquitto:1883
MQTT_INGEST_USERNAME=kinan-api
MQTT_INGEST_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
MOSQUITTO_PASSWORD_FILE=/mosquitto-auth/passwd
MOSQUITTO_ACL_FILE=/mosquitto-auth/acl
SESSION_TTL_MS=86400000
AUTH_WINDOW_MS=60000
AUTH_MAX_ATTEMPTS=10
API_WINDOW_MS=60000
API_MAX_REQUESTS=300
TELEMETRY_MAX_SAMPLES=500
TELEMETRY_MAX_BYTES=131072
TELEMETRY_MAX_CLOCK_SKEW_MS=300000
RETENTION_DAYS=30
SIMULATOR_MQTT_URL=mqtt://localhost:1883
SIMULATOR_PARAMETER_IDS=parameter_1
SIMULATOR_INTERVAL_MS=10000
SIMULATOR_DEVICE_ID=replace
SIMULATOR_DEVICE_SECRET=replace
SIMULATOR_CREDENTIAL_VERSION=1
