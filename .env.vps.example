# Used explicitly with --env-file .env.vps; do not reuse the local .env.
GHCR_OWNER=rchmdndy
# sha-<full 40-character commit SHA>, identical for API and web; no latest tag.
IMAGE_TAG=
# Required canonical HTTPS origin, e.g. https://telemetry.example.com (no path).
APP_ORIGIN=
# Generate once with openssl rand -base64 32. KEEP the key for existing data.
ENCRYPTION_KEY_BASE64=
MQTT_INGEST_USERNAME=kinan-api
# Generate independently with openssl rand -hex 32.
MQTT_INGEST_PASSWORD=
# Host loopback ports; external HTTPS proxy targets WEB_PORT.
WEB_PORT=8080
MQTT_PORT=1883
